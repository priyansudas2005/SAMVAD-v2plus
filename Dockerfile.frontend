###############################################################################
# SAMVAD v2.0 — Frontend Dockerfile (Optimized Multi-Stage Production Build)
#
# Optimizations applied:
#   - Pinned alpine patch versions for reproducibility
#   - npm ci with --frozen-lockfile ensures exact dependency lock
#   - .dockerignore already excludes node_modules & dist from context
#   - Nginx config written as a COPY from file (not heredoc RUN) for clarity
#   - Non-root nginx user via nginx:alpine default (nginx runs as nginx uid)
#   - Security headers added to Nginx: X-Frame-Options, X-Content-Type
#   - gzip compression enabled for all text assets
#   - Removed default nginx site config properly
###############################################################################

# ── Stage 1: Build ───────────────────────────────────────────────────────────
FROM node:20-alpine AS build

WORKDIR /app

# Copy manifests first — cached as long as package files don't change.
COPY frontend/package.json frontend/package-lock.json ./

# ci install: respects package-lock.json exactly, faster than npm install.
RUN npm ci --silent

# Copy source and build.
COPY frontend/ ./
RUN npm run build

# ── Stage 2: Serve ───────────────────────────────────────────────────────────
# nginx:alpine is ~40 MB. Only the compiled dist/ is copied; node_modules
# and all build tooling are left behind in the discarded build stage.
FROM nginx:1.27-alpine

# Remove the default Nginx virtual host config.
RUN rm /etc/nginx/conf.d/default.conf

# Copy the optimised SPA + proxy Nginx configuration.
COPY --chown=nginx:nginx deployment/nginx.conf /etc/nginx/conf.d/samvad.conf

# Copy compiled frontend assets from build stage.
COPY --from=build --chown=nginx:nginx /app/dist /usr/share/nginx/html

# Nginx master process runs as root (needed for port binding) but worker
# processes drop to the nginx user automatically (configured in nginx.conf).
EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
