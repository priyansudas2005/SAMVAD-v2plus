# SAMVAD v2.0 — Environment Configuration
#
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# The application will work out-of-the-box with all defaults.
# Only change values that differ from your environment.

# ── Host Port ─────────────────────────────────────────────────────────────────
# Port exposed on the Docker host for the frontend (Nginx) container.
# The backend is internal only — all requests route through the frontend proxy.
# Change this if port 3000 is already in use on your machine.
SAMVAD_PORT=3000

# ── Database Path ─────────────────────────────────────────────────────────────
# Absolute path inside the container where SQLite database files are stored.
# This path is mounted as the named volume `samvad-db` in docker-compose.yml.
# Do not change unless you are remapping the volume.
SAMVAD_DB_DIR=/app/data/database

# ── PyTorch CPU Thread Limits ─────────────────────────────────────────────────
# Caps the number of CPU threads used by PyTorch and NumPy.
# Prevents single inference jobs from monopolising all CPU cores.
# Default of 4 is safe for 8-core machines. Increase on high-core servers;
# decrease if SAMVAD shares the host with other CPU-intensive workloads.
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4
VECLIB_MAXIMUM_THREADS=4
NUMEXPR_NUM_THREADS=4
